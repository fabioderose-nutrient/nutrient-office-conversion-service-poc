# Nutrient Java SDK license key. Empty = evaluation mode (watermark on every page).
NUTRIENT_LICENSE_KEY=

# Port of the service
PORT=8080

# Locale of the process. Spreadsheet number formats (thousands and decimal separators) follow it.
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# Upload limits
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=200MB
MAX_FILES=20

# Documents converted at the same time
CONVERSION_CONCURRENCY=4

# Temporary job folders. Empty = a folder in the system temp directory.
JOBS_DIR=
JOBS_RETENTION_MINUTES=60
