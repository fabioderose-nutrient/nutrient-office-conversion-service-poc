<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.nutrient.demo</groupId>
    <artifactId>office-conversion-service</artifactId>
    <version>1.0.0</version>
    <name>office-conversion-service</name>
    <description>Document conversion microservice with the Nutrient Java SDK</description>

    <properties>
        <java.version>21</java.version>
        <nutrient.version>2.1.13</nutrient.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.nutrient</groupId>
            <artifactId>nutrient-java-sdk</artifactId>
            <version>${nutrient.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- The SDK loads its native library from its own jar file, so the jar is
                         extracted from the executable jar to a temporary folder at startup. -->
                    <requiresUnpack>
                        <dependency>
                            <groupId>io.nutrient</groupId>
                            <artifactId>nutrient-java-sdk</artifactId>
                        </dependency>
                    </requiresUnpack>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
